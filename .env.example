# Salin ke .env.local (development) atau set di environment server (production).

# Alamat MongoDB. Contoh lokal: mongodb://127.0.0.1:27017
# Contoh dengan login: mongodb://lins:PASSWORD@127.0.0.1:27017/?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=lins_salon

# Login panel /admin (satu password). Gunakan yang panjang dan acak.
ADMIN_PASSWORD=
# Kunci penanda sesi login, minimal 16 karakter. Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# Folder penyimpanan foto yang diunggah. Kosongkan untuk memakai ./uploads.
# Di server, gunakan folder di luar kode agar aman saat deploy ulang, mis. /var/lib/lins-salon/uploads
UPLOAD_DIR=

# URL publik website (untuk SEO, sitemap, dan robots.txt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
